# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_, never commit the real value,
# never log it. Used only by lib/supabase/admin.ts (account deletion via the
# Admin API). Find it in Supabase project settings > API > Secret keys.
SUPABASE_SECRET_KEY=your-secret-key

# Server-only. Never prefix with NEXT_PUBLIC_, never commit the real value,
# never log it. Used only by lib/stripe/server.ts (the "support the app"
# one-time Checkout at /support). Prefer a Restricted Key (rk_...) scoped to
# Checkout Sessions creation only, rather than a full secret key (sk_...).
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=your-stripe-key

# Server-only. Never prefix with NEXT_PUBLIC_, never commit the real value,
# never log it. Signing secret for the webhook endpoint you create in the
# Stripe Dashboard (or `stripe listen` locally) pointing at
# /api/stripe/webhook. Used only by that route handler to verify events
# actually came from Stripe before recording a support payment.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Sentry error monitoring. The DSN is not a secret (it's meant to be public,
# same as any client-side analytics key) but all three of these are optional:
# leaving them unset disables Sentry entirely (see next.config.ts /
# sentry.*.config.ts / instrumentation*.ts), which is the default for local
# development and for this repo's build/CI. Sentry only actually sends events
# when NODE_ENV=production too, so set these in Netlify's env vars, not just
# here, once you've created a (free-tier) Sentry project.
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# Server-only, optional. Never commit the real value. Only needed to upload
# source maps at build time (for readable stack traces in Sentry); without it,
# Sentry still receives errors, just with minified stack traces. Create one at
# https://sentry.io (Settings > Auth Tokens) scoped to your org/project.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
